{
  "name": "wordforge",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "docker:config": "docker compose --env-file ./.env -f ./docker-compose.yml config --quiet",
    "docker:dev:config": "docker compose --env-file ./.env -f ./docker-compose.dev.yml config --quiet",
    "docker:prod:config": "docker compose --env-file ./.env -f ./docker-compose.prod.yml config --quiet",
    "docker:up": "docker compose --env-file ./.env -f ./docker-compose.yml up -d",
    "docker:dev:up": "docker compose --env-file ./.env -f ./docker-compose.dev.yml up -d",
    "docker:prod:up": "docker compose --env-file ./.env -f ./docker-compose.prod.yml up -d",
    "docker:down": "docker compose --env-file ./.env -f ./docker-compose.yml down --remove-orphans",
    "docker:dev:down": "docker compose --env-file ./.env -f ./docker-compose.dev.yml down --remove-orphans",
    "docker:prod:down": "docker compose --env-file ./.env -f ./docker-compose.prod.yml down --remove-orphans",
    "docker:restart": "pnpm docker:down && pnpm docker:up",
    "docker:dev:restart": "pnpm docker:dev:down && pnpm docker:dev:up",
    "docker:prod:restart": "pnpm docker:prod:down && pnpm docker:prod:up",
    "docker:logs": "docker compose --env-file ./.env -f ./docker-compose.yml logs -f",
    "docker:dev:logs": "docker compose --env-file ./.env -f ./docker-compose.dev.yml logs -f",
    "docker:prod:logs": "docker compose --env-file ./.env -f ./docker-compose.prod.yml logs -f",
    "docker:ps": "docker compose --env-file ./.env -f ./docker-compose.yml ps",
    "docker:dev:ps": "docker compose --env-file ./.env -f ./docker-compose.dev.yml ps",
    "docker:prod:ps": "docker compose --env-file ./.env -f ./docker-compose.prod.yml ps",
    "postgres:logs": "docker compose --env-file ./.env -f ./docker-compose.yml logs -f postgres",
    "postgres:dev:logs": "docker compose --env-file ./.env -f ./docker-compose.dev.yml logs -f postgres",
    "postgres:prod:logs": "docker compose --env-file ./.env -f ./docker-compose.prod.yml logs -f postgres",
    "postgres:shell": "docker compose --env-file ./.env -f ./docker-compose.yml exec postgres sh",
    "postgres:dev:shell": "docker compose --env-file ./.env -f ./docker-compose.dev.yml exec postgres sh",
    "postgres:prod:shell": "docker compose --env-file ./.env -f ./docker-compose.prod.yml exec postgres sh",
    "frontend:build": "pnpm --filter @wordforge/frontend run build",
    "frontend:start": "pnpm --filter @wordforge/frontend run start",
    "frontend:start:dev": "pnpm --filter @wordforge/frontend run dev",
    "frontend:lint": "pnpm --filter @wordforge/frontend run lint",
    "frontend:typecheck": "pnpm --filter @wordforge/frontend run typecheck",
    "frontend:test": "pnpm --filter @wordforge/frontend run test",
    "frontend:test:e2e": "pnpm --filter @wordforge/frontend run test:e2e",
    "backend:build": "pnpm --filter @wordforge/backend run build",
    "backend:lint": "pnpm --filter @wordforge/backend run lint",
    "backend:start": "pnpm --filter @wordforge/backend run start",
    "backend:start:dev": "pnpm --filter @wordforge/backend run start:dev",
    "backend:start:prod": "pnpm --filter @wordforge/backend run start:prod",
    "backend:typecheck": "pnpm --filter @wordforge/backend run typecheck",
    "backend:test": "pnpm --filter @wordforge/backend run test",
    "backend:test:e2e": "pnpm --filter @wordforge/backend run test:e2e",
    "backend:migration:generate": "pnpm --filter @wordforge/backend run migration:generate",
    "backend:migration:run": "pnpm --filter @wordforge/backend run migration:run",
    "backend:migration:revert": "pnpm --filter @wordforge/backend run migration:revert",
    "dev:backend": "pnpm backend:start:dev",
    "dev:frontend": "pnpm frontend:start:dev",
    "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "build:shared": "pnpm --filter @wordforge/shared-types run build",
    "build:backend": "pnpm backend:build",
    "build:frontend": "pnpm frontend:build",
    "build": "pnpm build:shared && pnpm build:backend && pnpm build:frontend",
    "pretypecheck": "pnpm build:shared",
    "prelint": "pnpm build:shared",
    "pretest": "pnpm build:shared",
    "lint": "pnpm --recursive --if-present run lint",
    "test:root-config": "node --test test/root-config.test.mjs",
    "test": "pnpm test:root-config && pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
