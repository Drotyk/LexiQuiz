# Database Settings
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=wordforge
DATABASE_USER=wordforge_user
DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# JWT Auth Settings
JWT_ACCESS_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MINIMUM_32_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
PORT=3001
NODE_ENV=development
